step(0.1)
check(phase() == "Lobby", "boots into Lobby")
local track = require(__modules["ServerScriptService/Server/Services/PathService"]):GetTrack()
check(math.abs(track:GetLength() - 100) < 1e-6, "track length 100")
check(track:GetPositionAt(50) == Vector3.new(40, 0, 10), "position at 50 = (40,0,10): " .. tostring(track:GetPositionAt(50)))
check(track:GetPositionAt(-5) == Vector3.new(0,0,0) and track:GetPositionAt(500) == Vector3.new(60,0,40), "clamps ends")
check(#ReplicatedStorage.Runtime.PathPoints:GetChildren() == 4, "path published")

local e = Enemy:Spawn("Infected")
step(1)
check(math.abs(e.Distance - 6) < 0.25, "walks 6 studs/s: " .. e.Distance)
Enemy:ApplyEffect(e, { Kind = "Slow", Magnitude = 0.5, Duration = 2 })
local d0 = e.Distance; step(1)
check(math.abs(e.Distance - d0 - 3) < 0.25, "slow halves speed: " .. (e.Distance - d0))
step(1.5)
check(e.Effects.Slow == nil and e.Speed == 6, "slow expires")
Enemy:ApplyEffect(e, { Kind = "Stun", Magnitude = 0, Duration = 1 })
d0 = e.Distance; step(0.9)
check(math.abs(e.Distance - d0) < 0.25, "stun stops movement")
Enemy:ApplyEffect(e, { Kind = "Burn", Magnitude = 2, Duration = 1, TickInterval = 0.5 })
step(1.2)
check(math.abs(e.Health - 2) < 1e-6, "burn deals 2 x 2 = 4: hp " .. e.Health)

local brute = Enemy:Spawn("Brute")
check(Enemy:ApplyEffect(brute, { Kind = "Stun", Magnitude = 0, Duration = 1 }) == false, "brute immune to stun")
check(math.abs(Enemy:Damage(brute, 10) - 7) < 1e-6, "30% armour: 10 -> 7")
check(math.abs(Enemy:Damage(brute, 10, nil, { PierceArmor = true }) - 10) < 1e-6, "pierce ignores armour")

local before = Enemy:GetCount()
local boss = Enemy:Spawn("PatientZero")
boss.Distance = 20
Enemy:Damage(boss, 2500 * 0.3 / 0.85)
check(Enemy:GetCount() == before + 1 + 4, "boss at 70% spawns 4 runners: count " .. Enemy:GetCount())
Enemy:Damage(boss, 2500 * 0.5 / 0.85)
check(Enemy:GetCount() == before + 1 + 4 + 6 + 3, "boss to 20% spawns phases 2 and 3 together")
check(remoteCount("BossPhase") == 3, "3 boss phase events")
local killed = Enemy:Damage(boss, 1e9)
check(not boss.Alive and Enemy:GetById(boss.Id) == nil, "boss dies")
check(remoteCount("EnemyRemoved") >= 1, "removal replicated")
step(0.5)
check(remoteCount("EnemyBatchUpdate") > 0, "batch updates sent")
local n = Enemy:GetCount()
Enemy:Clear()
check(Enemy:GetCount() == 0 and n > 0, "clear removes all")
